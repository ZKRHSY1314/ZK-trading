APP_NAME=A股AI交易驾驶舱
APP_ENV=local
DATABASE_PATH=./trading_local.sqlite3
LEGACY_DATA_DIR=../../数据集1
ENABLE_LIVE_TRADING=false
DEFAULT_CASH=200000
MIN_ORDER_LOT=100
COMMISSION_RATE=0.0003
STAMP_TAX_RATE=0.0005
SLIPPAGE_RATE=0.0005
DAILY_BAR_SOURCE_POLICY=tonghuasun_first
# Absolute path to the local Tonghuashun plugin home (holds config.json).
# Leave unset to let the adapter discover TONGHUASUN_AGENT_HOME or %LOCALAPPDATA%\TonghuasunCodex.
TONGHUASUN_PRODUCT_HOME=
TONGHUASUN_REQUEST_TIMEOUT_SECONDS=30
