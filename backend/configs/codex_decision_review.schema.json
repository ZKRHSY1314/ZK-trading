{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "model_profile",
    "market_posture",
    "reviews",
    "no_order_reason",
    "simulation_only",
    "live_trading_enabled"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "candidate_decision_review.v1"},
    "as_of": {"type": "string"},
    "model_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort"],
      "properties": {
        "model": {"type": "string", "const": "gpt-5.5"},
        "reasoning_effort": {"type": "string", "const": "medium"}
      }
    },
    "market_posture": {
      "type": "string",
      "enum": ["NO_ACTION", "WATCH_ONLY", "WAIT_FOR_CONFIRMATION"]
    },
    "reviews": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "symbol",
          "action",
          "confidence",
          "thesis",
          "confirmations",
          "invalidations",
          "uncertainties",
          "order_allowed"
        ],
        "properties": {
          "rank": {"type": "integer", "minimum": 1, "maximum": 12},
          "symbol": {"type": "string", "minLength": 8, "maxLength": 8},
          "action": {
            "type": "string",
            "enum": ["WAIT_BREAKOUT_REVIEW", "WAIT_PULLBACK_REVIEW", "WATCH_ONLY", "REJECT"]
          },
          "confidence": {"type": "string", "enum": ["low", "medium"]},
          "thesis": {"type": "string", "minLength": 1, "maxLength": 800},
          "confirmations": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "maxLength": 300}
          },
          "invalidations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {"type": "string", "maxLength": 300}
          },
          "uncertainties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {"type": "string", "maxLength": 300}
          },
          "order_allowed": {"type": "boolean", "const": false}
        }
      }
    },
    "no_order_reason": {"type": "string", "minLength": 1, "maxLength": 1000},
    "simulation_only": {"type": "boolean", "const": true},
    "live_trading_enabled": {"type": "boolean", "const": false}
  }
}
